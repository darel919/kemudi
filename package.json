{
  "name": "kemudi",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd app/kemudi.js dev",
    "dev:web": "bun run --cwd app/kemudi.js dev",
    "build": "bun run build:wasm && bun run build:web",
    "build:web": "bun run --cwd app/kemudi.js build",
    "build:wasm": "wasm-pack build crates/kemudi-engine --target web --out-dir ../../app/kemudi.js/public/pkg --release",
    "generate": "bun run --cwd app/kemudi.js generate",
    "preview": "bun run --cwd app/kemudi.js preview",
    "postinstall": "bun run --cwd app/kemudi.js postinstall",
    "test": "bun run --cwd app/kemudi.js test",
    "test:watch": "bun run --cwd app/kemudi.js test:watch",
    "lint": "bun run --cwd app/kemudi.js lint",
    "typecheck": "bun run --cwd app/kemudi.js typecheck",
    "multiplayer:server": "bun run --cwd app/kemudi.js multiplayer:server",
    "physics:benchmark": "cargo run --manifest-path crates/kemudi-engine/Cargo.toml --release --bin physics_benchmark",
    "test:rust": "cargo test --workspace"
  }
}
