			<Item class="LocalScript" referent="RBX454c87cc4b614b40b8982eeb00b9a8f2">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- StarterPlayerScripts bootstrap for the Rojo-built place.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local engine = ReplicatedStorage:WaitForChild("KemudiEngine")
local ok, err = pcall(function()
	require(engine:WaitForChild("runtime"):WaitForChild("client"))
end)
if not ok then
	warn("[KemudiClient] bootstrap failed: " .. tostring(err))
	error(err, 0)
end
]]></ProtectedString>
