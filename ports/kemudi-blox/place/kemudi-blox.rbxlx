						<string name="Name">ground_zero_grid</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">47d6b5893cf38d950a810e3d000028ec</UniqueId>
