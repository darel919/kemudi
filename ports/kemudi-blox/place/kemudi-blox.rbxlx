					<Item class="ModuleScript" referent="RBX47d0d6fd4f7d49879cdf875840a5c162">
						<Properties>
						<ProtectedString name="Source"><![CDATA[--[[
	Energy conservation tracking for the physics simulation.
	Tracks kinetic, potential, thermal, and deformation energy per frame.
	Reports energy drift for validation.
--]]

local Module = {}

local function nan_guard(v, fallback)
	if v == nil then return fallback end
	if v ~= v then return fallback end
	if v == math.huge or v == -math.huge then return fallback end
	return v
end

function Module.install(World, Math)

	-- State initialization
	function World:setupEnergyTracking()
		-- Gravitational constant
		self.gravity = self.gravity or 9.81
	end

	-- Called each step to compute and track energy
	function World:_computeEnergy()
		local nodes = self.nodes
		if not nodes or #nodes == 0 then return end

		self.energy = self.energy or {
			kinetic = 0,
			potential = 0,
			thermal = 0,
			deformation = 0,
			total = 0,
			previousTotal = 0,
			drift = 0,
		}

		local g = self.gravity
		local kin = 0
		local pot = 0
		local def = 0

		-- Kinetic + potential energy from nodes
		for i = 1, #nodes do
			local n = nodes[i]
			if not n.fixed then
				local m = math.max(n.mass, 0)
				local v2 = n.vx*n.vx + n.vy*n.vy + n.vz*n.vz
				kin = kin + 0.5 * m * v2
				pot = pot + m * g * math.max(n.y, 0)
			end
		end

		-- Deformation energy from beams (0.5 * k * (len - rest)^2)
		local beams = self.beams
		if beams then
			for i = 1, #beams do
				local b = beams[i]
				if not b.broken then
					local a = self.nodes[b.nodeA + 1]
					local c = self.nodes[b.nodeB + 1]
					if a and c then
						local dx = c.x - a.x
						local dy = c.y - a.y
						local dz = c.z - a.z
						local len = math.sqrt(dx*dx + dy*dy + dz*dz)
						local stretch = len - b.length
						if stretch ~= stretch then stretch = 0 end
						local k = b.stiffness or 0
						if k > 0 then
							def = def + 0.5 * k * stretch * stretch
						end
					end
				end
			end
		end

		-- Thermal energy from subsystems (approximate)
		local therm = 0
		if self.engine_thermal then
			local et = self.engine_thermal
			if et.thermal and et.thermal.coolant_temp then
				-- Convert coolant temp to energy (approximate)
				therm = therm + (et.thermal.coolant_temp - 20) * 100000 -- arbitrary scaling
			end
		end
		if self.tire_thermal then
			for i = 1, #self.tire_thermal do
				local tt = self.tire_thermal[i]
				if tt and tt.temperature then
					therm = therm + (tt.temperature - 20) * 50000
				end
			end
		end

		-- Total energy
		local total = kin + pot + therm + def

		-- Drift
		local prev = self.energy.previousTotal or total
		local drift = total - prev

		-- Store
		self.energy.kinetic = kin
		self.energy.potential = pot
		self.energy.thermal = therm
		self.energy.deformation = def
		self.energy.total = total
		self.energy.previousTotal = total
		self.energy.drift = drift
	end

	-- Get energy report for telemetry
	function World:getEnergyReport()
		if not self.energy then return {} end
		return {
			kinetic = self.energy.kinetic,
			potential = self.energy.potential,
			thermal = self.energy.thermal,
			deformation = self.energy.deformation,
			total = self.energy.total,
			drift = self.energy.drift,
		}
	end

end -- Module.install

return Module]]></ProtectedString>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">energy</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags"></SharedString>
						<UniqueId name="UniqueId">ef92185029774565bc1f3dcba83c6ffa</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXafd1254f28524a0382aea109bd8f3a71">
						<Properties>
						<ProtectedString name="Source"><![CDATA[--[[
	Solver hardening for XPBD constraint solver.
	Overrides World:_solveXPBD with configurable iterations, warm starting,
	velocity damping, anti-tunnel clamping, and adaptive compliance.

	Install after constraints.luau so the override replaces the original.
--]]

local Module = {}

-- ponytail: Adaptive compliance thresholds are tuned for a 0.0167s fixed dt.
-- If fixedDt changes significantly, rescale stressLo/stressHi.

function Module.install(World, Math)

-- Default solver tuning (set on World if not already present)
if World.solverIterations == nil then World.solverIterations = 40 end
if World.maxSolverIterations == nil then World.maxSolverIterations = 80 end
if World.velocityDamping == nil then World.velocityDamping = 0.99995 end
if World.previousBeamLambdas == nil then World.previousBeamLambdas = {} end
if World.previousTriLambdas == nil then World.previousTriLambdas = {} end

-- Adaptive compliance thresholds (lambda/dt² stress measure)
local ADAPTIVE_STRESS_LO = 50      -- below this: softer compliance for better convergence
local ADAPTIVE_STRESS_HI = 5000    -- above this: stiffer compliance to resist load
local COMPLIANCE_FLOOR = 1e-7      -- minimum compliance (stiffest)
local COMPLIANCE_CEIL = 1e-3       -- maximum compliance (softest)
local BASE_BEAM_COMPLIANCE = 1     -- = 1/max(stiffness, 1) baseline

local function computeAdaptiveCompliance(stress, dt2)
	-- Map stress to compliance: high stress → stiff, low stress → soft
	local t
	if stress < ADAPTIVE_STRESS_LO then
		t = 0
	elseif stress > ADAPTIVE_STRESS_HI then
		t = 1
	else
		t = (stress - ADAPTIVE_STRESS_LO) / (ADAPTIVE_STRESS_HI - ADAPTIVE_STRESS_LO)
	end
	-- Interpolate between soft and stiff
	return COMPLIANCE_CEIL + (COMPLIANCE_FLOOR - COMPLIANCE_CEIL) * t
end

function World:_solveXPBD()
	local nodes = self.nodes
	local beams = self.beams
	local triangles = self.triangles
	local nodeCount = #nodes
	local beamCount = #beams
	local triCount = #triangles

	local dt = self.fixedDt
	if not (dt > 0 and dt == dt) then dt = 1 / 60 end
	local dt2 = dt * dt
	local invDt = 1 / math.max(dt, 1e-6)

	-- Clamp iterations to configured bounds
	local iterations = self.solverIterations or 40
	iterations = math.min(iterations, self.maxSolverIterations or 80)
	iterations = math.max(iterations, 1)

	-- Warm starting: seed lambdas from previous frame for faster convergence
	local prevBeam = self.previousBeamLambdas
	local prevTri = self.previousTriLambdas
	for i = 1, beamCount do
		local beam = beams[i]
		if i <= #prevBeam and not beam.broken then
			beam.lambda = prevBeam[i] * 0.8  -- damped warm start (80% carryover)
		else
			beam.lambda = 0
		end
	end
	for i = 1, triCount do
		if i <= #prevTri then
			triangles[i].lambda = prevTri[i] * 0.8
		else
			triangles[i].lambda = 0
		end
	end
	self.volumeLambda = 0

	local function clamp(v, lo, hi)
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

local function solveBeamProjection()
		for bi = 1, beamCount do
			local beam = beams[bi]
			if not beam.broken then
				local a = beam.nodeA + 1
				local b = beam.nodeB + 1
				if a <= nodeCount and b <= nodeCount then
					local na = nodes[a]
					local nb = nodes[b]
					local dx = nb.x - na.x
					local dy = nb.y - na.y
					local dz = nb.z - na.z
					local len = math.sqrt(dx*dx + dy*dy + dz*dz)
					if len > 1e-8 then
						local c = len - beam.length
						local invSum = na.invMass + nb.invMass
						if invSum > 0 then
							-- Adaptive compliance: stiffer under load, softer near rest
							local stress = math.abs(beam.lambda / math.max(dt2, 1e-12))
							local compliance = computeAdaptiveCompliance(stress, dt2)
							local alpha = compliance / dt2
							local dLambda = (-c - alpha * beam.lambda) / (invSum + alpha)
							-- NaN guard
							if dLambda ~= dLambda then dLambda = 0 end
							beam.lambda += dLambda
							local nx, ny, nz = dx/len, dy/len, dz/len
							if not na.fixed then
								na.x -= dLambda * na.invMass * nx
								na.y -= dLambda * na.invMass * ny
								na.z -= dLambda * na.invMass * nz
							end
							if not nb.fixed then
								nb.x += dLambda * nb.invMass * nx
								nb.y += dLambda * nb.invMass * ny
								nb.z += dLambda * nb.invMass * nz
							end
						end
					end
				end
			end
		end
	end

	local function solveTriangleArea()
		for ti = 1, triCount do
			local tri = triangles[ti]
			local ai, bi2, ci = tri.a + 1, tri.b + 1, tri.c + 1
			if ai <= nodeCount and bi2 <= nodeCount and ci <= nodeCount then
				local a = nodes[ai]
				local b = nodes[bi2]
				local c = nodes[ci]
				local abx, aby, abz = b.x - a.x, b.y - a.y, b.z - a.z
				local acx, acy, acz = c.x - a.x, c.y - a.y, c.z - a.z
				local crx, cry, crz = Math.cross3({abx,aby,abz},{acx,acy,acz})
				local doubleArea = math.sqrt(crx*crx + cry*cry + crz*crz)
				if doubleArea >= 1e-10 then
					local nn = { crx/doubleArea, cry/doubleArea, crz/doubleArea }
					local gradAx, gradAy, gradAz = Math.scale3(Math.cross3({b.x-c.x,b.y-c.y,b.z-c.z}, nn), 0.5)
					local gradBx, gradBy, gradBz = Math.scale3(Math.cross3({c.x-a.x,c.y-a.y,c.z-a.z}, nn), 0.5)
					local gradCx, gradCy, gradCz = Math.scale3(Math.cross3(nn, {abx,aby,abz}), 0.5)
					local area = doubleArea * 0.5
					local error_ = area - tri.restArea
					local compliance = 1e-5 / math.max(dt2, 1e-12)
					local wSum = a.invMass * (gradAx*gradAx+gradAy*gradAy+gradAz*gradAz)
						+ b.invMass * (gradBx*gradBx+gradBy*gradBy+gradBz*gradBz)
						+ c.invMass * (gradCx*gradCx+gradCy*gradCy+gradCz*gradCz)
					local denom = wSum + compliance
					if denom > 1e-12 then
						local dL = (-error_ - compliance * tri.lambda) / denom
						if dL ~= dL then dL = 0 end
						tri.lambda += dL
						if a.invMass > 0 then
							a.x += dL * a.invMass * gradAx
							a.y += dL * a.invMass * gradAy
							a.z += dL * a.invMass * gradAz
						end
						if b.invMass > 0 then
							b.x += dL * b.invMass * gradBx
							b.y += dL * b.invMass * gradBy
							b.z += dL * b.invMass * gradBz
						end
						if c.invMass > 0 then
							c.x += dL * c.invMass * gradCx
							c.y += dL * c.invMass * gradCy
							c.z += dL * c.invMass * gradCz
						end
					end
				end
			end
		end
	end

	-- Solver iteration loop
	for _iter = 1, iterations do
		solveBeamProjection()
		solveTriangleArea()
		self:_solveBodyAttachmentConstraints()
		self:_solveVolumePreservation()
	end

	-- Beam damping (once after all iterations)
	self:_applyBeamDamping(dt)

	-- Feed constraint correction into velocity
	for i = 1, nodeCount do
		local n = nodes[i]
		if not n.fixed then
			local sp = self.constraintStartPositions[i]
			if sp then
				n.vx += (n.x - sp[1]) * invDt
				n.vy += (n.y - sp[2]) * invDt
				n.vz += (n.z - sp[3]) * invDt
			end
		end
	end

	-- Velocity damping per substep
	self:_applyVelocityDamping()

	-- Anti-tunnel: clamp nodes below terrain
	self:_antiTunnelClamp()

	-- Save lambdas for next frame's warm starting
	-- (store after all corrections so the carryover is meaningful)
	for i = 1, beamCount do
		prevBeam[i] = beams[i].lambda
	end
	for i = 1, triCount do
		prevTri[i] = triangles[i].lambda
	end
end

-- Velocity damping: exponential decay per substep to absorb micro-vibrations.
function World:_applyVelocityDamping()
	local d = self.velocityDamping or 0.99995
	-- NaN guard
	if d ~= d then d = 0.99995 end
	local nodes = self.nodes
	for i = 1, #nodes do
		local n = nodes[i]
		if not n.fixed then
			n.vx = n.vx * d
			n.vy = n.vy * d
			n.vz = n.vz * d
		end
	end
end

-- Anti-tunnel: prevent non-fixed, non-wheel nodes from sinking below terrain.
function World:_antiTunnelClamp()
	local nodes = self.nodes
	-- Wheel nodes are indices 1-4 (suspension handles their ground contact)
	local WHEEL_COUNT = 4
	for i = WHEEL_COUNT + 1, #nodes do
		local n = nodes[i]
		if not n.fixed then
			local th = self:terrainHeight(n.x, n.z)
			if th ~= th then th = 0 end -- NaN guard on terrain query
			if n.y < th then
				local penetration = th - n.y
				n.y = th + 0.01
				-- Reflect vertical velocity with energy loss
				if n.vy < 0 then
					n.vy = -n.vy * 0.3
				end
				-- Horizontal friction scales with penetration depth: deeper
				-- penetration → more friction (harder to slide through terrain).
				local frictionFactor = clamp(1 - penetration * 2, 0.5, 1.0)
				n.vx = n.vx * frictionFactor
				n.vz = n.vz * frictionFactor
			end
		end
	end
end

end -- Module.install

return Module
]]></ProtectedString>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">solver_harden</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags"></SharedString>
						<UniqueId name="UniqueId">da1e1a1755ba453f9cbfec89b34c240f</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX37f434ac1da347c8968bbe9d8c31dfbd">
						<Properties>
						<ProtectedString name="Source"><![CDATA[--[[
	Terrain deformation module — writes wheel contact deformations into
	the existing terrainRuts grid, and provides elastic recovery and
	rolling-resistance feedback to the vehicle system.

	ALL CONFIG MUST BE PROVIDED BY VEHICLE ASSET / MAP DATA.
	No vehicle-specific defaults in engine code.
--]]

local Module = {}

local function nan_guard(v, fallback)
	if v == nil then return fallback end
	if v ~= v then return fallback end
	if v == math.huge or v == -math.huge then return fallback end
	return v
end

local function clamp(v, lo, hi)
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

-- Install ----------------------------------------------------------------

function Module.install(World, Contract, Math)
	local gridSize = Contract.TERRAIN_GRID_SIZE
	local extent = Contract.TERRAIN_EXTENT
	local gridSizeSq = gridSize * gridSize

	-- Helper: safe grid index
	local function safeGridIndex(x, z)
		local gx = math.floor((x / extent + 0.5) * gridSize)
		local gz = math.floor((z / extent + 0.5) * gridSize)
		gx = clamp(gx, 0, gridSize - 1)
		gz = clamp(gz, 0, gridSize - 1)
		return gx, gz, gz * gridSize + gx + 1
	end

	-- State initialization — called once after World.new()
	-- ALL values MUST come from vehicle asset / map data
	function World:setupTerrainDeformation()
		-- Vehicle asset provides: tire contact patch area (m²)
		self.contact_patch_area = self.contact_patch_area
		-- Map data provides: surface hardness (0 = soft mud, 1 = concrete)
		self.surfaceHardness = self.surfaceHardness
		-- Map data provides: rut recovery rate (m/s)
		self.rutRecoveryRate = self.rutRecoveryRate
		-- Map data provides: maximum rut depth (m)
		self.maxRutDepth = self.maxRutDepth
		-- Vehicle asset provides: spread factor (0-1)
		self.spreadFactor = self.spreadFactor
		-- Map data provides: recovery depth damping (0-1)
		self.recoveryDepthDamping = self.recoveryDepthDamping
		-- Vehicle asset provides: max rolling resistance coefficient
		self.resistanceMax = self.resistanceMax
	end

	function World:_ensureTerrainDeformState()
		if self.maxRutDepth == nil then
			self:setupTerrainDeformation()
		end
	end

	-- Per-step deformation from grounded wheel contacts.
	function World:_updateTerrainDeformation(dt)
		self:_ensureTerrainDeformState()
		if not (dt > 0 and dt == dt) then return end

		local states = self.suspension_states
		if not states then return end

		local nodes = self.nodes
		local ruts = self.terrainRuts

		-- If required config is missing, skip deformation
		if not self.contact_patch_area or not self.surfaceHardness or not self.maxRutDepth then
			return
		end

		local contactArea = self.contact_patch_area
		local hardness = nan_guard(self.surfaceHardness, 0.5)
		local maxDepth = self.maxRutDepth
		local spreadFactor = nan_guard(self.spreadFactor, 0)

		-- Vehicle speed for speed factor
		local speed = 0
		if self.telemetry then
			speed = self.telemetry[Contract.T.SPEED_MPS + 1] or 0
		end
		if not (speed == speed) then speed = 0 end
		speed = math.max(speed, 0)

		-- Speed factor: slower = more deformation (more time in contact)
		local speedFactor = clamp(1 / (1 + speed * 0.5), 0.2, 1.0)

		for i = 1, math.min(#states, 4) do
			local st = states[i]
			if st and not st.is_airborne then
				local wheelLoad = nan_guard(st.load, 0)
				if wheelLoad > 0 then
					-- Contact point position
					local wx, wz
					if st.contact_point and st.contact_point[1] == st.contact_point[1] and st.contact_point[3] == st.contact_point[3] then
						wx = st.contact_point[1]
						wz = st.contact_point[3]
					else
						local n = nodes[i]
						if n then
							wx = n.x
							wz = n.z
						else
							continue
						end
					end

					-- Pressure-based deformation
					local pressure = wheelLoad / contactArea
					local hardnessFactor = 1 - clamp(hardness, 0, 1)
					local deformation = pressure * hardnessFactor * 0.00001 * dt * speedFactor

					if deformation > 0 then
						local gx, gz, idx = safeGridIndex(wx, wz)

						-- Write center cell
						local newVal = clamp((ruts[idx] or 0) + deformation, 0, maxDepth)
						ruts[idx] = newVal

						-- Spread to immediate neighbors (8-connected)
						for dz = -1, 1 do
							for dx = -1, 1 do
								if dx == 0 and dz == 0 then
									-- continue (Lua doesn't have continue, use if)
								else
									local nx_ = gx + dx
									local nz_ = gz + dz
									if nx_ >= 0 and nx_ < gridSize and nz_ >= 0 and nz_ < gridSize then
										local nIdx = nz_ * gridSize + nx_ + 1
										ruts[nIdx] = clamp(
											(ruts[nIdx] or 0) + deformation * spreadFactor,
											0, maxDepth
										)
									end
								end
							end
						end
					end
				end
			end
		end
	end

	-- Elastic recovery — call once per fixed step after deformation.
	function World:_recoverTerrainDeformation(dt)
		self:_ensureTerrainDeformState()
		if not (dt > 0 and dt == dt) then return end

		local ruts = self.terrainRuts
		local recoveryRate = nan_guard(self.rutRecoveryRate, 0)
		local maxDepth = self.maxRutDepth
		local recoveryDamping = nan_guard(self.recoveryDepthDamping, 0)

		if maxDepth <= 0 or recoveryRate <= 0 then return end

		for i = 1, gridSizeSq do
			local depth = ruts[i]
			if depth > 0 then
				-- Deeper ruts recover slower
				local depthRatio = depth / maxDepth
				local rate = recoveryRate * (1 - depthRatio * recoveryDamping)
				local newDepth = depth - rate * dt
				if newDepth < 0 then newDepth = 0 end
				ruts[i] = newDepth
			end
		end
	end

	-- API: set surface hardness (0 = soft mud, 1 = concrete/asphalt).
	function World:setSurfaceHardness(hardness)
		self:_ensureTerrainDeformState()
		self.surfaceHardness = clamp(hardness, 0, 1)
	end

	-- Query: rolling resistance from rut depth.
	-- Returns a coefficient in [0, resistanceMax].
	function World:getRutResistance(nodeX, nodeZ)
		self:_ensureTerrainDeformState()
		local _, _, idx = safeGridIndex(nodeX, nodeZ)
		local depth = self.terrainRuts[idx] or 0
		local maxDepth = self.maxRutDepth
		local resistanceMax = nan_guard(self.resistanceMax, 0)
		if maxDepth <= 0 or resistanceMax <= 0 then return 0 end
		return clamp(depth / maxDepth * resistanceMax, 0, resistanceMax)
	end

end -- Module.install

return Module]]></ProtectedString>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">terrain_deform</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags"></SharedString>
						<UniqueId name="UniqueId">fd206e36d76441959274e0e3a0121adb</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX988b5155ae444b0faba76da2c908c594">
						<Properties>
						<ProtectedString name="Source"><![CDATA[--[[
	Vehicle-to-vehicle collision module.
	Handles node-vs-node contact between different vehicles using a
	spatial hash broadphase. Installed as World methods; see init.luau
	for wiring.

	ALL CONFIG MUST BE PROVIDED BY VEHICLE ASSET / NETWORK.
	No vehicle-specific defaults in engine code.
--]]

local Module = {}

local function nan_guard(v, fallback)
	if v == nil then return fallback end
	if v ~= v then return fallback end
	if v == math.huge or v == -math.huge then return fallback end
	return v
end

function Module.install(World, Math)

-- ── State initialization ────────────────────────────────────────────────
-- Spatial hash grid for broadphase
-- ALL values MUST come from vehicle asset / map data
function World:setupVehicleCollision()
	-- Spatial hash cell size (meters) - from vehicle asset
	self.cellSize = self.cellSize
	-- Grid half-extent (meters) - from map data
	self.gridExtent = self.gridExtent
	-- Collision restitution (0-1) - from vehicle asset
	self.collisionRestitution = self.collisionRestitution
	-- Collision friction (0-1) - from vehicle asset
	self.collisionFriction = self.collisionFriction
	-- Damage threshold (impulse in N) - from vehicle asset
	self.collisionDamageThreshold = self.collisionDamageThreshold
end

-- Identity - set by network layer
World.vehicleId = nil
World.otherVehicles = {} -- [id] = { nodes = {{x,y,z}...}, mass = N, lastUpdate = t }
World.impactImpulses = {} -- per-node inter-vehicle impulse vectors

function World:_ensureCollisionState()
	if self.cellSize == nil then
		self:setupVehicleCollision()
	end
end

-- ── Public API ──────────────────────────────────────────────────────────

function World:setVehicleId(id)
	self.vehicleId = id
end

function World:registerOtherVehicle(id, nodePositions, totalMass)
	if id == nil then return end
	if type(nodePositions) ~= "table" or #nodePositions == 0 then return end
	if not (totalMass > 0 and totalMass == totalMass) then totalMass = 1 end
	self.otherVehicles[id] = {
		nodes = nodePositions,
		mass = totalMass,
		lastUpdate = self.time or 0,
	}
end

function World:unregisterOtherVehicle(id)
	self.otherVehicles[id] = nil
end

-- ── Broadphase ──────────────────────────────────────────────────────────

local function gridKey(gx, gz)
	return gx * 100003 + gz -- cheap hash; 100003 is prime
end

function World:_buildSpatialHash()
	self:_ensureCollisionState()
	if not self.cellSize or not self.gridExtent then return {} end

	local grid = {}
	local cellSize = self.cellSize
	local extent = self.gridExtent
	local invCell = 1 / math.max(cellSize, 1e-4)

	-- Helper: insert one node entry into the grid
	local function insertEntry(vId, nodeIdx, x, y, z, mass)
		x = nan_guard(x, 0)
		y = nan_guard(y, 0)
		z = nan_guard(z, 0)
		if not (x == x) then return end -- skip NaN
		local gx = math.floor((x + extent) * invCell)
		local gz = math.floor((z + extent) * invCell)
		-- Clamp to valid range
		local maxCell = math.floor(extent * invCell * 2)
		if gx < 0 then gx = 0 elseif gx > maxCell then gx = maxCell end
		if gz < 0 then gz = 0 elseif gz > maxCell then gz = maxCell end
		local key = gridKey(gx, gz)
		local cell = grid[key]
		if not cell then
			cell = {}
			grid[key] = cell
		end
		cell[#cell + 1] = {
			vehicleId = vId,
			nodeIndex = nodeIdx,
			x = x, y = y, z = z,
			mass = math.max(mass, 1e-4),
		}
	end

	-- Insert self nodes
	local nodes = self.nodes
	for i = 1, #nodes do
		local n = nodes[i]
		if not n.fixed then
			insertEntry(self.vehicleId, i, n.x, n.y, n.z, n.mass)
		end
	end

	-- Insert other vehicles
	for vId, vData in self.otherVehicles do
		local vNodes = vData.nodes
		local nodeMass = if #vNodes > 0 then vData.mass / #vNodes else 0
		for j = 1, #vNodes do
			local p = vNodes[j]
			if p and p[1] == p[1] and p[3] == p[3] then
				insertEntry(vId, j, p[1], p[2] or 0, p[3], nodeMass)
			end
		end
	end

	return grid
end

-- ── Narrowphase & Contact ──────────────────────────────────────────────

-- Contact radius for collision detection (from vehicle asset)
function World:_collisionContactRadius()
	return assert(self.collision_contact_radius, "vehicle collision contact radius was not authored")
end

function World:_solveVehicleCollisions(dt)
	self:_ensureCollisionState()
	if not (dt > 0 and dt == dt) then return end

	-- Required config check
	if not self.cellSize or not self.gridExtent or not self.collisionRestitution or not self.collisionFriction then
		return
	end

	local grid = self:_buildSpatialHash()
	local nodes = self.nodes
	local contactRadius = self:_collisionContactRadius()
	local restitution = self.collisionRestitution
	local friction = self.collisionFriction
	local damageThreshold = self.collisionDamageThreshold or 0

	-- Clear previous impulses
	self.impactImpulses = {}

	-- For each cell, check self vs other nodes
	for key, cell in pairs(grid) do
		if #cell > 1 then
			for i = 1, #cell do
				local a = cell[i]
				if a.vehicleId == self.vehicleId then
					for j = 1, #cell do
						local b = cell[j]
						if b.vehicleId ~= self.vehicleId then
							-- Potential collision
							local dx = b.x - a.x
							local dy = b.y - a.y
							local dz = b.z - a.z
							local distSq = dx*dx + dy*dy + dz*dz
							local minDist = contactRadius * 2

							if distSq < minDist * minDist and distSq > 1e-8 then
								local dist = math.sqrt(distSq)
								local nx, ny, nz = dx/dist, dy/dist, dz/dist

								-- Relative velocity
								local na = nodes[a.nodeIndex]
								local nb_vx, nb_vy, nb_vz = 0, 0, 0
								-- Other vehicle velocity would come from network state
								-- For now assume stationary (or pass in via otherVehicles data)

								if na then
									local rvx = na.vx - nb_vx
									local rvy = na.vy - nb_vy
									local rvz = na.vz - nb_vz
									local vRel = rvx*nx + rvy*ny + rvz*nz

									if vRel < 0 then -- approaching
										-- Impulse: j = -(1+e) * vRel / (1/m1 + 1/m2)
										local m1 = na.mass
										local m2 = b.mass
										local invMassSum = 1/m1 + 1/m2
										if invMassSum > 0 then
											local j = -(1 + restitution) * vRel / invMassSum
											if damageThreshold > 0 and j > damageThreshold then
												-- Damage event - flag for visual/deformation system
												self.impactImpulses[a.nodeIndex] = {
													impulse = j,
													direction = {nx, ny, nz},
													otherVehicle = b.vehicleId,
													damage = math.min(j / damageThreshold, 10)
												}
											end

											-- Apply impulse
											local ix = j * nx
											local iy = j * ny
											local iz = j * nz

											na.vx = na.vx + ix / m1
											na.vy = na.vy + iy / m1
											na.vz = na.vz + iz / m1

											-- Friction impulse (tangential)
											local tvx = rvx - vRel * nx
											local tvy = rvy - vRel * ny
											local tvz = rvz - vRel * nz
											local tSpeed = math.sqrt(tvx*tvx + tvy*tvy + tvz*tvz)
											if tSpeed > 1e-6 then
												local jt = math.min(friction * math.abs(j), tSpeed * m1 * m2 / (m1 + m2) / dt)
												na.vx = na.vx - jt * tvx / tSpeed / m1
												na.vy = na.vy - jt * tvy / tSpeed / m1
												na.vz = na.vz - jt * tvz / tSpeed / m1
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

-- Telemetry
function World:getCollisionTelemetry()
	if not self.impactImpulses then return {} end
	local totalImpulse = 0
	local maxImpulse = 0
	local count = 0
	for _, imp in pairs(self.impactImpulses) do
		totalImpulse = totalImpulse + (imp.impulse or 0)
		maxImpulse = math.max(maxImpulse, imp.impulse or 0)
		count = count + 1
	end
	return {
		impact_count = count,
		total_impulse = totalImpulse,
		max_impulse = maxImpulse,
	}
end

end -- Module.install

return Module]]></ProtectedString>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">vehicle_collision</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags"></SharedString>
						<UniqueId name="UniqueId">5ecee0c5bcf242f5af520261aa32e9f3</UniqueId>
						</Properties>
					</Item>
		</Item>
			<Item class="ModuleScript" referent="RBXafc25bb8ce304e37876a079c6284ee47">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	Server runtime — runs the physics simulation on Heartbeat.
	Owns the authoritative simulation state. Client receives snapshots only.
	No Roblox API in the core modules — this file is the only Roblox-dependent code.
--]]

local RunService = game:GetService("RunService")
local Physics = require(script.Parent.physics)
local Contract = require(script.Parent.contract)
local Chassis = require(script.chassis)

local Runtime = {}
Runtime.__index = Runtime

local function frameToCFrame(frame, scale)
	local right = frame.right
	local up = frame.up
	local forward = frame.forward
	local position = frame.position
	return CFrame.fromMatrix(
		Vector3.new(position[1] * scale, position[2] * scale, position[3] * scale),
		Vector3.new(right[1], right[2], right[3]),
		Vector3.new(up[1], up[2], up[3]),
		Vector3.new(-forward[1], -forward[2], -forward[3]))
end

-- ============================================================
-- Vehicle instance — binds physics World to Roblox workspace
-- ============================================================

local function makeVehicleId()
	return string.format("vehicle_%d_%d", os.clock() * 1000, math.random(1000, 9999))
end

function Runtime.new(config)
	config = config or {}
	local self = setmetatable({}, Runtime)

	self.world = Physics.new()  -- returns the World module
	self.id = makeVehicleId()
	self.owner = nil            -- Player who owns this vehicle
	self.root_part = nil        -- PrimaryPart of the vehicle model
	self.driver_seat = nil      -- authored Seat used for server-authoritative entry
	self.driver_seat_binding = nil
	self.engine_state = "OFF"
	self.engine_on = false
	self.model = nil
	self.node_parts = {}        -- map: nodeIndex → Part
	self.oriented_parts = {}    -- map: nodeIndex → body/root presentation Part
	self.render_bindings = {}   -- render BaseParts bound to the solver chassis frame
	self.wheel_bindings = {}    -- authored wheel visuals bound to wheel spin/steering
	self.wheel_spin = { 0, 0, 0, 0 }
	self.beam_constraints = {}  -- map: beamIndex → Beam (Roblox Instance)
	self.active = false
	self.heartbeat_conn = nil
	self.control_age = 0
	self.snapshot_timer = 0
	self.telemetry_timer = 0
	self.snapshot_interval = config.snapshot_interval or (1 / 20)
	self.telemetry_interval = config.telemetry_interval or (1 / 20)
	self.on_snapshot = config.on_snapshot
	self.on_telemetry = config.on_telemetry
	self.on_transmission_alert = config.on_transmission_alert

	-- Vehicle config
	self.suspension_config = config.suspension_config
	self.steering_config = config.steering_config
	self.tire_compounds = config.tire_compounds
	self.drivetrain_config = config.drivetrain_config
	self.vehicle_mass = config.vehicle_mass
	self.drive_layout = config.drive_layout
	self.simulation_config = config.simulation_config
	self.studs_per_meter = config.studs_per_meter
	self.suspension_config = config.suspension_config
	self.static_parts = config.static_parts or {}

	return self
end

-- ============================================================
-- Vehicle lifecycle
-- ============================================================

-- Spawn: create the vehicle from a data definition.
-- node_defs: array of { part, mass, fixed } definitions from the asset loader
-- beam_defs: array of { nodeA, nodeB, stiffness, damping, strength }
-- render_parts: anchored visual BaseParts bound to the emergent chassis frame
function Runtime:spawn(owner, node_defs, beam_defs, root_part, render_parts, wheels, driver_seat)
	self.owner = owner
	self.root_part = root_part
	self.driver_seat = driver_seat
	self.driver_seat_binding = nil
	self.engine_state = "OFF"
	self.engine_on = false
	self.model = if root_part then root_part:FindFirstAncestorOfClass("Model") else nil
	self.node_parts = {}
	self.oriented_parts = {}
	self.render_bindings = {}
	self.beam_constraints = {}
	self.wheel_bindings = {}
	self.wheel_spin = { 0, 0, 0, 0 }
	self.control_age = 0
	self.snapshot_timer = 0
	self.telemetry_timer = 0

	assert(type(self.vehicle_mass) == "number" and self.vehicle_mass > 0, "vehicle mass must be derived from an authored asset")
	assert(type(self.studs_per_meter) == "number" and self.studs_per_meter > 0, "asset must define StudsPerMeter")
	assert(driver_seat and driver_seat:IsA("Seat"), "asset must define an authored DriverSeat")

	-- Add nodes from validated asset definitions.
	for i, node_def in node_defs do
		local part = node_def.part
		local mountPart = node_def.mountPart or part
		local pos = mountPart.Position
		local mass = node_def.mass
		local fixed = node_def.fixed == true
		local id = i - 1 -- 0-indexed
		self.world:addNode(id, pos.X / self.studs_per_meter, pos.Y / self.studs_per_meter, pos.Z / self.studs_per_meter, mass, fixed)
		self.node_parts[id] = mountPart
		self.oriented_parts[id] = mountPart:GetAttribute("KemudiOriented") == true or id >= 4
	end

	local initialChassisFrame = Chassis.frameFromNodes(self.world.nodes)
	if initialChassisFrame and render_parts then
		local initialCFrame = frameToCFrame(initialChassisFrame, self.studs_per_meter)
		self.driver_seat_binding = initialCFrame:ToObjectSpace(driver_seat.CFrame)
		for _, part in render_parts do
			table.insert(self.render_bindings, {
				part = part,
				offset = initialCFrame:ToObjectSpace(part.CFrame),
			})
		end
		local wheelIds = { "FL", "FR", "RL", "RR" }
		local seenVisuals = {}
		for index, wheelId in wheelIds do
			local wheel = wheels and wheels[wheelId]
			local visual = if wheel then wheel.visual else nil
			if visual then
				local existing = seenVisuals[visual]
				if existing then
					table.insert(existing.indices, index)
					local node = self.world.nodes[index]
					local nodePosition = Vector3.new(node.x * self.studs_per_meter, node.y * self.studs_per_meter, node.z * self.studs_per_meter)
					table.insert(existing.node_local_positions, initialCFrame:PointToObjectSpace(nodePosition))
				else
					local node = self.world.nodes[index]
					local nodePosition = Vector3.new(node.x * self.studs_per_meter, node.y * self.studs_per_meter, node.z * self.studs_per_meter)
					local binding = {
						indices = { index },
						visual = visual,
						offset = initialCFrame:ToObjectSpace(visual.CFrame),
						node_local_positions = { initialCFrame:PointToObjectSpace(nodePosition) },
					}
					seenVisuals[visual] = binding
					table.insert(self.wheel_bindings, binding)
				end
			end
		end
	end

	-- Add beams
	if beam_defs then
		for i, beam in beam_defs do
			local id = i - 1
			self.world:addBeam(id, beam.nodeA, beam.nodeB,
				beam.stiffness, beam.damping, beam.strength)
		end
	end

	-- Import authored anchored map parts into the SI-unit custom solver. The
	-- visual Roblox parts remain in Workspace, but no longer rely on Roblox's
	-- separate rigid-body collision system for the authoritative vehicle.
	for _, part in self.static_parts do
		if part and part.Parent and part:IsA("BasePart") and part.Anchored and part.CanCollide then
			local position = part.Position
			local size = part.Size
			local right = part.CFrame.RightVector
			local up = part.CFrame.UpVector
			local forward = part.CFrame.LookVector
			self.world:addCollisionBox(
				position.X / self.studs_per_meter,
				position.Y / self.studs_per_meter,
				position.Z / self.studs_per_meter,
				size.X * 0.5 / self.studs_per_meter,
				size.Y * 0.5 / self.studs_per_meter,
				size.Z * 0.5 / self.studs_per_meter,
				0.0,
				0.8,
				{ right.X, right.Y, right.Z },
				{ up.X, up.Y, up.Z },
				{ forward.X, forward.Y, forward.Z }
			)
		end
	end
	local staticNodeCount = 0
	for _, node in self.world.nodes do
		if node.staticCollision then staticNodeCount += 1 end
	end
	print(string.format(
		"[KemudiEngine] static collision registered parts=%d boxes=%d nodes=%d",
		#self.static_parts,
		#self.world.collisionBoxes,
		staticNodeCount
	))

	-- Setup vehicle systems
	self.world:setupVehicle(
		self.suspension_config,
		self.steering_config,
		self.tire_compounds,
		self.vehicle_mass,
		self.drivetrain_config,
		self.simulation_config
	)
	self.world:setDrivetrainLayout(self.drive_layout)

	-- Start simulation
	self.active = true
	self.heartbeat_conn = RunService.Heartbeat:Connect(function(dt)
		self:update(dt)
	end)
end

-- Despawn: disconnect all loops, clean up references.
function Runtime:despawn()
	self.active = false
	if self.heartbeat_conn then
		self.heartbeat_conn:Disconnect()
		self.heartbeat_conn = nil
	end
	self.node_parts = {}
	self.oriented_parts = {}
	self.render_bindings = {}
	self.beam_constraints = {}
	self.wheel_bindings = {}
	self.wheel_spin = { 0, 0, 0, 0 }
	self.driver_seat = nil
	self.driver_seat_binding = nil
	self.engine_state = "OFF"
	self.engine_on = false
	if self.model then
		self.model:Destroy()
		self.model = nil
	end
	self.root_part = nil
	self.owner = nil
end

-- ============================================================
-- Simulation tick
-- ============================================================

function Runtime:update(dt)
	if not self.active then return end
	if type(dt) ~= "number" or dt ~= dt or dt < 0 then dt = 0 end
	self.control_age += dt
	self.world.controls.engine_on = self.engine_on
	self.world.controls.engine_stage = if self.engine_state == "ACCESSORY" then 1 elseif self.engine_state == "ON" then 2 else 0
	if self.control_age > 0.25 then
		-- Dead-man behavior: stop propulsion and request braking when input stops.
		self.world:setControls({ brake = 1, engine_on = self.engine_on, engine_stage = self.world.controls.engine_stage })
	end

	-- Step physics
	self.world:step(dt)
	local transmission = self.world.drivetrain and self.world.drivetrain.transmission
	if transmission and transmission.last_rejection then
		local reason = transmission.last_rejection
		local code = transmission.last_rejection_code or 0
		transmission.last_rejection = nil
		if self.on_transmission_alert then self.on_transmission_alert(reason, code, "rejection") end
	elseif transmission and transmission.last_warning then
		local reason = transmission.last_warning
		local code = transmission.last_warning_code or 0
		transmission.last_warning = nil
		if self.on_transmission_alert then self.on_transmission_alert(reason, code, "warning") end
	end

	-- Apply positions and the emergent chassis orientation to Parts.
	local chassisFrame = Chassis.frameFromNodes(self.world.nodes)
	local chassisCFrame = if chassisFrame then frameToCFrame(chassisFrame, self.studs_per_meter) else nil
	for node_idx, part in self.node_parts do
		local node = self.world.nodes[node_idx + 1] -- 0-indexed → 1-indexed
		if node and not node.fixed then
			if chassisFrame and self.oriented_parts[node_idx] then
				local right = chassisFrame.right
				local up = chassisFrame.up
				local forward = chassisFrame.forward
				part.CFrame = CFrame.fromMatrix(
					Vector3.new(node.x * self.studs_per_meter, node.y * self.studs_per_meter, node.z * self.studs_per_meter),
					Vector3.new(right[1], right[2], right[3]),
					Vector3.new(up[1], up[2], up[3]),
					Vector3.new(-forward[1], -forward[2], -forward[3]))
			else
				part.CFrame = CFrame.new(node.x * self.studs_per_meter, node.y * self.studs_per_meter, node.z * self.studs_per_meter)
			end
			-- Optional: set velocity for network interpolation
		end
	end
	if chassisCFrame then
		if self.driver_seat and self.driver_seat_binding and self.driver_seat.Parent then
			self.driver_seat.CFrame = chassisCFrame * self.driver_seat_binding
		end
		for _, binding in self.render_bindings do
			if binding.part.Parent then
				binding.part.CFrame = chassisCFrame * binding.offset
			end
		end
		local steeringStates = self.world.steering_states
		local suspensionStates = self.world.suspension_states
		for _, binding in self.wheel_bindings do
			local nodeX, nodeY, nodeZ, angularSpeed, suspensionLength = 0, 0, 0, 0, 0
			local contactX, contactY, contactZ, contactRadius, contactCount = 0, 0, 0, 0, 0
			local normalX, normalY, normalZ = 0, 0, 0
			local steering = 0
			local airborneCount = 0
			for _, index in binding.indices do
				local node = self.world.nodes[index]
				local state = suspensionStates[index]
				local wheelConfig = self.suspension_config and self.suspension_config.wheels[index]
				if node and state then
					nodeX += node.x
					nodeY += node.y
					nodeZ += node.z
					angularSpeed += state.angular_speed or 0
					local terrainHeight = if wheelConfig then self.world:terrainHeight(node.x, node.z) else 0
					local rawLength = if wheelConfig
						then node.y - terrainHeight - wheelConfig.tire_radius
						else (state.previous_suspension_length or 0)
					local currentAirborne = if wheelConfig
						then rawLength > wheelConfig.rest_length + wheelConfig.travel + 0.01
						else state.is_airborne
					if currentAirborne then airborneCount += 1 end
					local length = rawLength
					if length ~= length or length < 0 then length = 0 end
					if wheelConfig then
						length = math.min(length, wheelConfig.rest_length + wheelConfig.travel)
					end
					suspensionLength += length
					if not currentAirborne and wheelConfig then
						-- Read the post-step node position. state.contact_point is
						-- produced before integration and lags behind during launch.
						contactX += node.x
						contactY += terrainHeight
						contactZ += node.z
						contactRadius += wheelConfig.tire_radius
						local normal = self.world:terrainNormal(node.x, node.z)
						normalX += normal[1]
						normalY += normal[2]
						normalZ += normal[3]
						contactCount += 1
					end
					if index <= 2 then steering += steeringStates[index] or 0 end
				end
			end
			local count = math.max(#binding.indices, 1)
			local firstIndex = binding.indices[1]
			if binding.visual.Parent and firstIndex then
				angularSpeed /= count
				steering /= count
				suspensionLength /= count
				self.wheel_spin[firstIndex] = math.fmod(self.wheel_spin[firstIndex] - angularSpeed * dt, math.pi * 2)
				local bodyRotation = chassisCFrame - chassisCFrame.Position
				local currentNodePosition = Vector3.new(nodeX / count * self.studs_per_meter, nodeY / count * self.studs_per_meter, nodeZ / count * self.studs_per_meter)
				local position
				if contactCount > 0 and airborneCount < count then
					local contactPosition = Vector3.new(
						contactX / contactCount * self.studs_per_meter,
						contactY / contactCount * self.studs_per_meter,
						contactZ / contactCount * self.studs_per_meter
					)
					local averageRadius = contactRadius / contactCount * self.studs_per_meter
					local averageNormal = Vector3.new(normalX, normalY, normalZ)
					if averageNormal.Magnitude <= 1e-6 then averageNormal = Vector3.yAxis else averageNormal = averageNormal.Unit end
					position = contactPosition + averageNormal * averageRadius
				else
					position = currentNodePosition - chassisCFrame.UpVector * (suspensionLength * self.studs_per_meter)
				end
				local wheelRotation = binding.offset - binding.offset.Position
				binding.visual.CFrame = CFrame.new(position)
					* bodyRotation
					* CFrame.Angles(0, -steering, 0)
					* wheelRotation
					* CFrame.Angles(self.wheel_spin[firstIndex], 0, 0)
			end
		end
	end

	self.snapshot_timer += dt
	if self.on_snapshot and self.snapshot_timer >= self.snapshot_interval then
		self.snapshot_timer -= self.snapshot_interval
		self.on_snapshot(self:getSnapshot())
	end
	self.telemetry_timer += dt
	if self.on_telemetry and self.telemetry_timer >= self.telemetry_interval then
		self.telemetry_timer -= self.telemetry_interval
		self.on_telemetry(self:getTelemetry())
	end
end

-- ============================================================
-- Input handling (called by owner's client via RemoteEvent)
-- ============================================================

function Runtime:setControls(controls)
	if type(controls) ~= "table" then return end
	self.control_age = 0
	self.world:setControls(controls)
	self.world.controls.engine_on = self.engine_on
	self.world.controls.engine_stage = if self.engine_state == "ACCESSORY" then 1 elseif self.engine_state == "ON" then 2 else 0
end

function Runtime:setEngineState(state)
	if state ~= "OFF" and state ~= "ACCESSORY" and state ~= "ON" then return false end
	self.engine_state = state
	self.engine_on = state == "ON"
	self.world.controls.engine_on = self.engine_on
	self.world.controls.engine_stage = if state == "ACCESSORY" then 1 elseif state == "ON" then 2 else 0
	return true
end

function Runtime:cycleEngineState()
	local nextState = if self.engine_state == "OFF" then "ACCESSORY"
		elseif self.engine_state == "ACCESSORY" then "ON"
		else "OFF"
	self:setEngineState(nextState)
	return self.engine_state
end

-- ============================================================
-- Snapshot for network replication
-- ============================================================

-- Returns a compact snapshot of node positions and velocities.
function Runtime:getSnapshot()
	local nodes = self.world.nodes
	local snapshot = table.create(#nodes * 6 + 1)
	snapshot[1] = self.world.time
	for i, node in nodes do
		local base = (i - 1) * 6 + 2
		snapshot[base] = node.x
		snapshot[base + 1] = node.y
		snapshot[base + 2] = node.z
		snapshot[base + 3] = node.vx
		snapshot[base + 4] = node.vy
		snapshot[base + 5] = node.vz
	end
	return snapshot
end

-- Returns the telemetry buffer (86 floats).
function Runtime:getTelemetry()
	return self.world.telemetry
end

return Runtime
]]></ProtectedString>
